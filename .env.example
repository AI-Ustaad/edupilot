# ==============================================================================
# EduPilot SaaS ERP - Environment Configuration Specification (.env.example)
# All 37 runtime variables required across the codebase.
# ==============================================================================

# ------------------------------------------------------------------------------
# 1. CORE APPLICATION & ROUTING
# ------------------------------------------------------------------------------
# Node runtime environment (development, test, production)
NODE_ENV=development

# Base URL for public links and API requests
NEXT_PUBLIC_BASE_URL=http://localhost:3000

# Canonical public app URL used in notifications and emails
NEXT_PUBLIC_APP_URL=http://localhost:3000

# ------------------------------------------------------------------------------
# 2. FIREBASE ADMIN SDK (SERVER-SIDE)
# ------------------------------------------------------------------------------
# Firebase project ID
FIREBASE_PROJECT_ID=edupilot-saas

# Firebase service account client email
FIREBASE_CLIENT_EMAIL=firebase-adminsdk@edupilot-saas.iam.gserviceaccount.com

# Firebase service account private key (unescaped newline format in production)
FIREBASE_PRIVATE_KEY="-----BEGIN PRIVATE KEY-----\nyour_private_key_content_here\n-----END PRIVATE KEY-----\n"

# Firebase Cloud Storage default bucket
FIREBASE_STORAGE_BUCKET=edupilot-saas.appspot.com

# Optional: Local Firestore emulator host (e.g., 127.0.0.1:8080)
FIRESTORE_EMULATOR_HOST=

# Initial default super-admin user email for bootstrap
ADMIN_EMAIL=superadmin@edupilot.com

# ------------------------------------------------------------------------------
# 3. FIREBASE CLIENT WEB SDK (CLIENT-SIDE)
# ------------------------------------------------------------------------------
NEXT_PUBLIC_FIREBASE_API_KEY=your_firebase_api_key_here
NEXT_PUBLIC_FIREBASE_AUTH_DOMAIN=edupilot-saas.firebaseapp.com
NEXT_PUBLIC_FIREBASE_PROJECT_ID=edupilot-saas
NEXT_PUBLIC_FIREBASE_STORAGE_BUCKET=edupilot-saas.appspot.com
NEXT_PUBLIC_FIREBASE_MESSAGING_SENDER_ID=your_sender_id_here
NEXT_PUBLIC_FIREBASE_APP_ID=your_app_id_here

# ------------------------------------------------------------------------------
# 4. UPSTASH REDIS & QSTASH (RATE LIMITING & ASYNC QUEUES)
# ------------------------------------------------------------------------------
# Upstash REST Redis URL for rate limiters
UPSTASH_REDIS_REST_URL=https://your-upstash-redis-instance.upstash.io

# Upstash REST Redis Token
UPSTASH_REDIS_REST_TOKEN=your_upstash_redis_rest_token

# Upstash QStash Token for durable asynchronous outbox processing
QSTASH_TOKEN=your_qstash_token

# QStash signing keys for webhook signature verification
QSTASH_CURRENT_SIGNING_KEY=your_qstash_current_signing_key
QSTASH_NEXT_SIGNING_KEY=your_qstash_next_signing_key

# ------------------------------------------------------------------------------
# 5. STRIPE PAYMENT & SUBSCRIPTION BILLING
# ------------------------------------------------------------------------------
# Stripe secret API key (starts with sk_test_ or sk_live_)
STRIPE_SECRET_KEY=your_stripe_secret_key_here

# Stripe webhook signing secret (starts with whsec_)
STRIPE_WEBHOOK_SECRET=your_stripe_webhook_secret_here

# Stripe Price IDs for SaaS subscription plans
STRIPE_STARTER_PRICE_ID=price_starter_monthly_sample
STRIPE_PROFESSIONAL_PRICE_ID=price_pro_monthly_sample
STRIPE_ENTERPRISE_PRICE_ID=price_enterprise_monthly_sample

# ------------------------------------------------------------------------------
# 6. EXTERNAL COMMUNICATIONS (EMAIL & SMS)
# ------------------------------------------------------------------------------
# Resend API key for transactional emails
RESEND_API_KEY=your_resend_api_key_here

# SendGrid API key and sender address (fallback mail service)
SENDGRID_API_KEY=your_sendgrid_api_key_here
SENDGRID_FROM_EMAIL=noreply@edupilot.com

# Twilio SMS credentials
TWILIO_ACCOUNT_SID=your_twilio_account_sid_here
TWILIO_AUTH_TOKEN=your_twilio_auth_token_here
TWILIO_PHONE_NUMBER=+10000000000

# ------------------------------------------------------------------------------
# 7. AI AGENTS & LLM PROVIDER (GOOGLE GEMINI)
# ------------------------------------------------------------------------------
# Google Gemini API key
GEMINI_API_KEY=your_gemini_api_key_here

# Default Gemini model
GEMINI_MODEL=gemini-2.5-flash-lite

# Gemini API Base URL
GEMINI_BASE=https://generativelanguage.googleapis.com/v1beta

# ------------------------------------------------------------------------------
# 8. SYSTEM, CRON & INFRASTRUCTURE
# ------------------------------------------------------------------------------
# Secret token for protecting cron maintenance webhooks
CRON_SECRET=your_secure_random_cron_secret_here

# Vercel deployment identifiers (automatically injected in Vercel environments)
VERCEL_DEPLOYMENT_ID=your_vercel_deployment_id
VERCEL_REGION=iad1
