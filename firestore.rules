rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {

    // Helper functions
    function isAuthenticated() {
      return request.auth != null;
    }

    function getUserData() {
      return get(/databases/$(database)/documents/users/$(request.auth.uid)).data;
    }

    function getUserRole() {
      return getUserData().role;
    }

    function getUserTenantId() {
      return getUserData().tenantId;
    }

    function isTenantMember(tenantId) {
      return isAuthenticated() && getUserTenantId() == tenantId;
    }

    function isAdmin() {
      return isAuthenticated() && getUserRole() == 'admin';
    }

    function isSuperAdmin() {
      return isAuthenticated() && getUserRole() == 'super_admin';
    }

    function isStaff() {
      return isAuthenticated() && (getUserRole() == 'admin' || getUserRole() == 'teacher' || getUserRole() == 'staff');
    }

    // Users collection - users can read their own data, admins can read tenant users.
    //
    // SECURITY (P0-04): A non-admin authenticated user MUST NOT be able to modify
    // authorization-sensitive fields on their own document. The previous
    // implementation allowed `allow write` whenever `request.auth.uid == userId`,
    // which let a client SDK caller flip `role`, `tenantId`, `isSuperAdmin`, or
    // `onboardingRequired` and immediately gain cross-tenant privileges
    // (because `isSuperAdmin()` / `isAdmin()` / `isTenantMember()` re-read
    // `getUserData()` from the same mutable document on every evaluation).
    //
    // The Firestore document is the authoritative authorization source
    // (consumed by `getSessionUser()` and by every `withPermission` gate), so
    // the rules layer is the primary defense.
    //
    // Legitimate self-writes (preserved):
    //   - First-time bootstrap (create):  email, name, photoURL, role:"guest",
    //     tenantId:null, onboardingRequired:true, createdAt, lastLoginAt,
    //     updatedAt.
    //   - Login touch (merge update):     lastLoginAt, updatedAt.
    //   - Migration bookkeeping (merge):  migratedFrom, migrationVersion,
    //     migrationCompletedAt, updatedAt, lastLoginAt.
    //
    // All privileged writes (`role`, `tenantId`, `isSuperAdmin`,
    // `onboardingRequired`, `email`) MUST go through the trusted server
    // (Firebase Admin SDK), which bypasses these rules by design.
    match /users/{userId} {
      allow read: if isAuthenticated() && (request.auth.uid == userId || isTenantMember(getUserData().tenantId));

      // ----- CREATE (bootstrap / new-user doc) -----
      // A self-create is only allowed for the user's own doc and only with a
      // closed allow-list of fields. role/tenantId/onboardingRequired MUST
      // match the server-defined defaults — a client may never pre-seed
      // itself as anything other than "guest" without a tenant.
      allow create: if isAuthenticated()
                    && request.auth.uid == userId
                    && request.resource.data.role == 'guest'
                    && request.resource.data.tenantId == null
                    && request.resource.data.onboardingRequired == true
                    && !request.resource.data.keys().hasAny([
                         'isSuperAdmin',
                         'customClaims',
                         'permissions'
                       ])
                    && request.resource.data.diff({
                         email: request.resource.data.email,
                         name: request.resource.data.name,
                         photoURL: request.resource.data.photoURL,
                         role: 'guest',
                         tenantId: null,
                         onboardingRequired: true,
                         createdAt: request.resource.data.createdAt,
                         lastLoginAt: request.resource.data.lastLoginAt,
                         updatedAt: request.resource.data.updatedAt
                       }).affectedKeys().hasOnly([
                         'email',
                         'name',
                         'photoURL',
                         'role',
                         'tenantId',
                         'onboardingRequired',
                         'createdAt',
                         'lastLoginAt',
                         'updatedAt'
                       ]);

      // ----- UPDATE -----
      // Self-update: allowed only when authorization-sensitive fields are
      // unchanged AND the new write touches ONLY fields in the allow-list
      // (plus the existing migration bookkeeping fields).
      allow update: if (request.auth.uid == userId
                       && request.resource.data.role == resource.data.role
                       && request.resource.data.tenantId == resource.data.tenantId
                       && request.resource.data.isSuperAdmin == resource.data.isSuperAdmin
                       && request.resource.data.onboardingRequired == resource.data.onboardingRequired
                       && request.resource.data.email == resource.data.email
                       && request.resource.data.diff(resource.data).affectedKeys().hasOnly([
                            'name',
                            'photoURL',
                            'lastLoginAt',
                            'updatedAt',
                            'migratedFrom',
                            'migrationVersion',
                            'migrationCompletedAt'
                          ]))
                    || (isSuperAdmin());

      // ----- DELETE -----
      // User self-deletion is forbidden; only a super_admin can remove a
      // user document (which should be a rare, audited operation).
      allow delete: if isSuperAdmin();
    }

    // Tenants collection - only admins and super admins
    match /tenants/{tenantId} {
      allow read: if isTenantMember(tenantId);
      allow write: if isSuperAdmin();

      match /settings/{docId} {
        allow read: if isTenantMember(tenantId);
        allow write: if isTenantMember(tenantId) && (isAdmin() || isSuperAdmin());
      }

      match /dashboard/{docId} {
        allow read: if isTenantMember(tenantId);
        allow write: if isTenantMember(tenantId) && (isAdmin() || isSuperAdmin());
      }
    }

    // Students collection - tenant-scoped
    match /students/{studentId} {
      allow read: if isTenantMember(resource.data.tenantId);
      allow create: if isAuthenticated() && isStaff() && request.resource.data.tenantId == getUserTenantId();
      allow update, delete: if isAuthenticated() && isStaff() && resource.data.tenantId == getUserTenantId();

      match /timeline/{docId} {
        allow read: if isTenantMember(get(/databases/$(database)/documents/students/$(studentId)).data.tenantId);
        allow write: if isAuthenticated() && isStaff();
      }
    }

    // Staff collection - tenant-scoped
    match /staff/{staffId} {
      allow read: if isTenantMember(resource.data.tenantId);
      allow create: if isAuthenticated() && isAdmin() && request.resource.data.tenantId == getUserTenantId();
      allow update, delete: if isAuthenticated() && isAdmin() && resource.data.tenantId == getUserTenantId();
    }

    // Attendance - tenant-scoped
    match /attendance/{docId} {
      allow read: if isTenantMember(resource.data.tenantId);
      allow write: if isAuthenticated() && isStaff() && request.resource.data.tenantId == getUserTenantId();
    }

    // Fees - tenant-scoped
    match /fees/{feeId} {
      allow read: if isTenantMember(resource.data.tenantId);
      allow write: if isAuthenticated() && (isAdmin() || getUserRole() == 'finance') && request.resource.data.tenantId == getUserTenantId();
    }

    // Marks - tenant-scoped
    match /marks/{markId} {
      allow read: if isTenantMember(resource.data.tenantId);
      allow write: if isAuthenticated() && isStaff() && request.resource.data.tenantId == getUserTenantId();
    }

    // Classes - tenant-scoped
    match /classes/{classId} {
      allow read: if isTenantMember(resource.data.tenantId);
      allow write: if isAuthenticated() && isStaff() && request.resource.data.tenantId == getUserTenantId();
    }

    // Sections - tenant-scoped
    match /sections/{sectionId} {
      allow read: if isTenantMember(resource.data.tenantId);
      allow write: if isAuthenticated() && (isAdmin() || isSuperAdmin()) && request.resource.data.tenantId == getUserTenantId();
    }

    // Subscriptions - tenant-scoped
    match /subscriptions/{tenantId} {
      allow read: if isTenantMember(tenantId);
      allow write: if isSuperAdmin();
    }

    // Durable outbox infrastructure is server-only. Workers use the Admin SDK;
    // browser clients must never inspect another tenant's event payloads.
    match /events/{eventId} {
      allow read, write: if false;
    }

    match /processed_events/{eventId} {
      allow read, write: if false;
    }

    match /dead_letter_events/{eventId} {
      allow read, write: if false;
    }

    // Logs - audit trail, admin only
    match /logs/{logId} {
      allow read: if isAuthenticated() && (isAdmin() || isSuperAdmin());
      allow write: if isAuthenticated();
    }

    // Chat messages - tenant-scoped
    match /chat_messages/{messageId} {
      allow read: if isTenantMember(resource.data.tenantId);
      allow write: if isAuthenticated() && isStaff() && request.resource.data.tenantId == getUserTenantId();
    }

    // Syllabus - tenant-scoped
    match /syllabus/{docId} {
      allow read: if isTenantMember(resource.data.tenantId);
      allow write: if isAuthenticated() && isStaff() && request.resource.data.tenantId == getUserTenantId();
    }

    // Homework - tenant-scoped
    match /homework/{docId} {
      allow read: if isTenantMember(resource.data.tenantId);
      allow write: if isAuthenticated() && isStaff() && request.resource.data.tenantId == getUserTenantId();
    }

    // Video lectures - tenant-scoped
    match /video_lectures/{docId} {
      allow read: if isTenantMember(resource.data.tenantId);
      allow write: if isAuthenticated() && isStaff() && request.resource.data.tenantId == getUserTenantId();
    }

    // Buses - tenant-scoped
    match /buses/{busId} {
      allow read: if isTenantMember(resource.data.tenantId);
      allow write: if isAuthenticated() && isStaff() && request.resource.data.tenantId == getUserTenantId();
    }

    // Behavior - tenant-scoped
    match /behavior/{docId} {
      allow read: if isTenantMember(resource.data.tenantId);
      allow write: if isAuthenticated() && isStaff() && request.resource.data.tenantId == getUserTenantId();
    }

    // Books - tenant-scoped
    match /books/{bookId} {
      allow read: if isTenantMember(resource.data.tenantId);
      allow write: if isAuthenticated() && isStaff() && request.resource.data.tenantId == getUserTenantId();
    }

    // Ledger - tenant-scoped
    match /ledger/{docId} {
      allow read: if isTenantMember(resource.data.tenantId);
      allow write: if isAuthenticated() && (isAdmin() || getUserRole() == 'finance') && request.resource.data.tenantId == getUserTenantId();
    }

    // Admit cards - tenant-scoped
    match /admit_cards/{docId} {
      allow read: if isTenantMember(resource.data.tenantId);
      allow write: if isAuthenticated() && isStaff() && request.resource.data.tenantId == getUserTenantId();
    }

    // Leave requests - tenant-scoped
    match /leave_requests/{docId} {
      allow read: if isTenantMember(resource.data.tenantId);
      allow write: if isAuthenticated() && isStaff() && request.resource.data.tenantId == getUserTenantId();
    }

    // Exams - tenant-scoped
    match /exams/{examId} {
      allow read: if isTenantMember(resource.data.tenantId);
      allow write: if isAuthenticated() && isStaff() && request.resource.data.tenantId == getUserTenantId();
    }

    // Quizzes - tenant-scoped
    match /quizzes/{quizId} {
      allow read: if isTenantMember(resource.data.tenantId);
      allow write: if isAuthenticated() && isStaff() && request.resource.data.tenantId == getUserTenantId();
    }

    // Assignments - tenant-scoped
    match /assignments/{assignmentId} {
      allow read: if isTenantMember(resource.data.tenantId);
      allow write: if isAuthenticated() && isStaff() && request.resource.data.tenantId == getUserTenantId();
    }

    // Default deny - any collection not explicitly matched above
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
